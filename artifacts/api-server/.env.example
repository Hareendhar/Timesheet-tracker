# Port the API server listens on.
PORT=8080

# Where the frontend is served. Google redirects back to THIS server (a
# different origin/port than the frontend in local dev), so the OAuth
# callback needs this to build an absolute redirect back to the app —
# a relative redirect would resolve against this server's own origin instead.
FRONTEND_URL=http://localhost:19667

# Comma-separated list of allowed frontend origins for CORS. If unset, localhost
# and *.replit.dev/*.repl.co/*.replit.app domains are allowed automatically.
# CORS_ORIGIN=https://timesheets.yourcompany.com

# Secret used to sign the session cookie. Set a long random value in production.
# SESSION_SECRET=replace-with-a-long-random-string

# --- Dev-only "pick any employee" login ---
# Set to "true" to enable GET /api/auth/users and POST /api/auth/select-user
# (the employee-picker login used before Google SSO was wired up). Leave unset
# or "false" in production so those endpoints 404 and only Google SSO works.
AUTH_DEV_MODE=true

# --- Google OAuth (required for "Sign in with Google") ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# ideally with the OAuth consent screen's User Type set to "Internal" so only
# your Workspace org's accounts can even reach the consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI registered on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Comma-separated list of Google Workspace domains allowed to log in (checked
# against the ID token's `hd` claim), in addition to the employee-email
# allow-list. Add more domains here later (e.g. an acquired company's own
# Workspace tenant) without any code changes. Leave unset to skip this check
# (the employee-email allow-list still applies either way).
GOOGLE_WORKSPACE_DOMAINS=versatileitsol.com
